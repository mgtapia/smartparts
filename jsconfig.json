{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "paths": {
      "@/*": ["src/*"],
      "@features/*": ["src/features/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@contexts/*": ["src/contexts/*"],
      "@hocs/*": ["src/hocs/*"],
      "@theme/*": ["src/theme/*"],
      "@libs/*": ["src/libs/*"],
      "@utils/*": ["src/utils/*"],
      "@schemas/*": ["src/schemas/*"],
      "@constants/*": ["src/constants/*"],
      "@mocks/*": ["src/mocks/*"],
      "@core/*": ["src/core/*"],
      "@connectors/*": ["src/connectors/*"]
    }
  },
  "include": ["app/**/*", "src/**/*", "next.config.mjs"],
  "exclude": ["node_modules"]
}
