{
  "name": "smartparts-app",
  "version": "0.1.0",
  "private": true,
  "description": "SmartParts — importación de repuestos de vehículos eléctricos China → Chile. Next.js + Material UI + Firebase.",
  "scripts": {
    "dev": "next dev",
    "dev:limpio": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node scripts/seed-firestore.mjs",
    "db:seed:reset": "node scripts/seed-firestore.mjs --reset"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.3.0",
    "@mui/material-nextjs": "^6.3.0",
    "@mui/x-data-grid": "^7.23.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.0",
    "formik": "^2.4.6",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
