// Security Rules — SmartParts. Ver docs/SEGURIDAD-Y-ROLES.md para la matriz
// completa y el razonamiento. El rol sale SIEMPRE del custom claim del token
// (request.auth.token.role), nunca de un campo en users/{uid} editable por
// el cliente.
//
// ESTADO ACTUAL (bootstrap, ver .agent/STATUS.md §Bloqueos): todavía no se
// diferencia por rol (admin/buyer/viewer) — ambos usuarios del equipo son
// admin de hecho. Mientras tanto, `isAllowedEmail()` es el único borde real:
// cualquier cuenta de Google fuera de esa lista queda afuera aunque logre
// autenticarse. Reemplazar cada bloque "bootstrap" por la versión comentada
// debajo apenas la matriz de roles importe (más de 2 usuarios) — no antes.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allowlist temporal — mientras no hay custom claims, esto es lo único
    // que impide que cualquier cuenta de Google entre y escriba. Mantener
    // sincronizado a mano con src/constants/allowedEmails.js.
    function isAllowedEmail() {
      return request.auth.token.email_verified == true
        && request.auth.token.email in
        ['matiastapia91@gmail.com', 'dmezastange@gmail.com'];
    }

    function signedIn() {
      return request.auth != null && isAllowedEmail();
    }

    // --- Versión final (activar cuando haya custom claims — hoy sin usar) ---
    // function role() { return request.auth.token.role; }
    // function isAdmin() { return signedIn() && role() == 'admin'; }
    // function isBuyer() { return signedIn() && (role() == 'buyer' || isAdmin()); }
    // function canViewMargin() { return signedIn() && (request.auth.token.canViewMargin == true || isAdmin()); }

    // cost_param_sets: inmutable una vez creado — nunca se corrige, se versiona.
    match /cost_param_sets/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Resto de colecciones de dominio — bootstrap: sesión alcanza.
    match /{collection}/{docId} {
      allow read, write: if signedIn();
    }

    // Subcolecciones (parts/{id}/baseline_prices, shipments/{id}/lines, etc.).
    match /{path=**} {
      allow read, write: if signedIn();
    }
  }
}
